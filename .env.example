# ============================================================
# XYZ AI Backend — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.
# ============================================================

# --- Application ---
APP_NAME=XYZ AI
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# --- Database ---
# Local Dev: postgresql://postgres:postgres@localhost:5433/xyz_ai
# Production AWS RDS: postgresql://<db_user>:<db_password>@<rds_endpoint>:5432/<db_name>
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5433/xyz_ai

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# --- Google Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- ERP Backend ---
# Local: http://127.0.0.1:8000
# Production EC2 / Domain: http://127.0.0.1:8000 or https://api.yourdomain.com
ERP_BASE_URL=http://127.0.0.1:8000

# --- CORS ---
# Allow requests from local dev and production Vercel frontend
# Example: http://localhost:3000,https://xyz-ai.vercel.app
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Deployment ---
ALLOWED_HOSTS=["*"]
