[Unit]
Description=XYZ AI FastAPI Production Service
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/xyz-ai/backend
Environment="PATH=/var/www/xyz-ai/backend/venv/bin"
EnvironmentFile=/var/www/xyz-ai/backend/.env
ExecStart=/var/www/xyz-ai/backend/venv/bin/gunicorn -k uvicorn.workers.UvicornWorker app.main:app --bind 127.0.0.1:8000 --workers 4 --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
